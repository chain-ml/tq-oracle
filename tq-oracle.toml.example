# TQ Oracle Configuration Example
# This file demonstrates a comprehensive production-ready configuration

vault_address = "0x277C6A642564A91ff78b008022D65683cEE5CCC5"

vault_rpc = "https://ethereum-rpc.publicnode.com"
safe_address = "0x3F1C3Eb0bC499c1A091B635dEE73fF55E19cdCE9"
network = "mainnet"

dry_run = true
log_level = "DEBUG"
additional_asset_support = true


ignore_timeout_check = true
ignore_active_proposal_check = true

# Pyth price validation settings
pyth_enabled = true
pyth_max_confidence_ratio = 0.01  # Maximum allowed confidence ratio for Pyth prices (default: 0.03)
pyth_hermes_endpoint = "https://hermes.pyth.network"
pyth_staleness_threshold = 60

# Chainlink settings (optional - for stable USD stablecoin pricing)
# Enable to use Chainlink ETH/USD oracle instead of CoW Swap for stablecoins
chainlink_enabled = true
chainlink_eth_usd_feed = "0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419"  # Mainnet ETH/USD
chainlink_stablecoins = [
    "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",  # USDC
    "0xdAC17F958D2ee523a2206206994597C13D831ec7",  # USDT
    "0x4c9EDD5852cd905f086C759E8383e09bff1E68B3",  # USDe
    "0x6B175474E89094C44Da98b954EedeAC495271d0F",  # DAI
]

# CoinGecko settings - enabled for RWA asset pricing
# Enable to use CoinGecko API for stable, batched pricing
# API key: Set via TQ_ORACLE_COINGECKO_API_KEY environment variable
coingecko_enabled = true

# Map token addresses to CoinGecko IDs
[coingecko_token_ids]
"0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48" = "usd-coin"  # USDC
"0xdAC17F958D2ee523a2206206994597C13D831ec7" = "tether"    # USDT
"0x6B175474E89094C44Da98b954EedeAC495271d0F" = "dai"        # DAI
"0xE556ABa6fe6036275Ec1f87eda296BE72C811BCE" = "nusd-2"    # nUSD - Usual USD

# Aave V3 adapter configuration - supports multi-pool/fork tracking
# Example shows both Aave V3 (official) and Spark (Aave V3 fork)
[[adapters.aave_v3]]
name = "aave"
pool_address = "0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2"
base_asset_type = "eth"  # 'eth' or 'usd'

# Supply tokens (aTokens) - defaults to common ETH mainnet tokens if not specified
[adapters.aave_v3.supply_tokens]
WETH = "0x4d5F47FA6A74757f35C14fD3a6Ef8E3C9BC514E8"
wstETH = "0x0B925eD163218f6662a35e0f0371Ac234f9E9371"
USDC = "0x98C23E9d8f34FEFb1B7BD6a91B7FF122F4e16F5c"
USDT = "0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a"
USDe = "0x4F5923Fc5FD4a93352581b38B7cD26943012DECF"  # aEthUSDe
pt_susde_04feb2026 = "0xbe54767735fB7Acca2aa7E2d209a6f705073536D" #aPT-sUSDe-feb2026


# Borrow tokens (variable debt) - defaults to common ETH mainnet tokens if not specified
[adapters.aave_v3.borrow_tokens]
WETH = "0xeA51d7853EEFb32b6ee06b1C12E6dcCA88Be0fFE"
wstETH = "0xC96113eED8cAB59cD8A66813bCB0cEb29F06D2e4"
USDC = "0x72E95b8931767C79bA4EeE721354d6E99a61D004"
USDT = "0x6df1C1E379bC5a00a7b4C6e67A203333772f45A8"
USDe = "0x015396E1F286289aE23a762088E863b3ec465145"  # Variable debt USDe

# Spark instance (Aave V3 fork)
[[adapters.aave_v3]]
name = "spark"
pool_address = "0xC13e21B648A5Ee794902342038FF3aDAB66BE987"
base_asset_type = "eth"
[adapters.aave_v3.supply_tokens]
WETH = "0x59cD1C87501baa753d0B5B5Ab5D8416A45cD71DB"   # spWETH
wstETH = "0x12B54025C112Aa61fAce2CDB7118740875A566E9" # spwstETH
DAI = "0x4DEDf26112B3Ec8eC46e7E31EA5e123490B05B8B"   # spDAI
sDAI = "0x78f897F0fE2d3B5690EbAe7f19862DEacedF10a7"  # spsDAI
USDC = "0x377C3bd93f2a2984E1E7bE6A5C22c525eD4A4815"  # spUSDC
USDS = "0xC02aB1A5eaA8d1B114EF786D9bde108cD4364359"  # spUSDS
[adapters.aave_v3.borrow_tokens]
WETH = "0x2e7576042566f8D6990e07A1B61Ad1efd86Ae70d"   # Variable debt WETH
wstETH = "0xd5c3E3B566a42A6110513Ac7670C1a86D76E13E6" # Variable debt wstETH
DAI = "0xf705d2B7e92B3F38e6ae7afaDAA2fEE110fE5914"   # Variable debt DAI
USDC = "0x7B70D04099CB9cfb1Db7B6820baDAfB4C5C70A67"  # Variable debt USDC
USDS = "0x8c147debea24Fb98ade8dDa4bf142992928b449e"  # Variable debt USDS

# Pendle adapter configuration
[adapters.pendle]
oracle_address = "0x9a9Fa8338dd5E5B2188006f1Cd2Ef26d921650C2"

# Configure Pendle markets to track
[adapters.pendle.markets.pt_jrusde_27mar2026]
market = "0xfAbEEFC5369aA5270B401f4Ee062D17fb5f1EC2A"  # PT-jrUSDe market
accounting_asset = "0x4c9EDD5852cd905f086C759E8383e09bff1E68B3"  # USDe

[adapters.pendle.markets.pt_snusd_04mar2026]
market = "0x6D8C4DE7071D5AeE27fc3a810764E62a4a00Ceb9"  # PT-sNUSD market
accounting_asset = "0xE556ABa6fe6036275Ec1f87eda296BE72C811BCE"  # nUSD

[adapters.pendle.markets.pt_susde_04feb2026]
market = "0xed81f8ba2941c3979de2265c295748a6b6956567"  # PT-sUSDe market
accounting_asset = "0x4c9EDD5852cd905f086C759E8383e09bff1E68B3"  # USDe

# ERC4626 vault adapter - converts vault tokens to underlying
[adapters.erc4626]
[adapters.erc4626.vaults.snusd]
vault_token = "0x08EFCC2F3e61185D0EA7F8830B3FEc9Bfa2EE313"  # sNUSD
underlying_asset = "0xE556ABa6fe6036275Ec1f87eda296BE72C811BCE"  # nUSD

[adapters.erc4626.vaults.jrusde]
vault_token = "0x4F6673346aB4813F1665327aB39087008Cc7d76F"  # jrUSDe
underlying_asset = "0x4c9EDD5852cd905f086C759E8383e09bff1E68B3"  # USDe

# Uniswap V3 adapter configuration (optional)
[adapters.uniswap_v3]
# position_manager defaults to mainnet: 0xC36442b4a4522E871399CD717aBDD847Ab11FE88
# No additional configuration needed - adapter auto-discovers NFT positions

# Uniswap V4 adapter configuration (optional)
[adapters.uniswap_v4]
position_manager = "0xbd216513d74c8cf14cf4747e6aaa6420ff64ee9e"  # Mainnet V4 PositionManager
# pool_manager defaults to mainnet: 0x000000000004444c5dc75cb358380d2e3de08a90

# idle balances adapter
[adapters.idle_balances]
extra_addresses = ["0x17aeAbfD3cB214A8757bF07D2E248d526c8C4809"]
# nUSD tracked here for idle balances + CoinGecko pricing
non_tvl_tokens = { USDC = "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48", USDT = "0xdAC17F958D2ee523a2206206994597C13D831ec7", USDe = "0x4c9EDD5852cd905f086C759E8383e09bff1E68B3", nUSD = "0xE556ABa6fe6036275Ec1f87eda296BE72C811BCE" }

[adapters.stakewise]
# stakewise_exit_max_lookback_blocks = 219_600 # Approx. 1 month worth of blocks (assuming ~12s block time)
stakewise_vault_addresses = [
    # "0xAC0F906E433d58FA868F936E8A43230473652885", # genesis
    "0xe6D8d8Ac54461b1c5ed15740eeE322043F696C08", # chorus one
]
# skip_exit_queue_scan = false
# extra_addresses = ["0xEF3bBCB9dF930C9ba9e12d9856a34626ae3D9963"]

# Subvault configurations
# Subvault 1 - Aave V3 leveraged positions (WETH + USD stablecoins)
# Demonstrates using both Aave and Spark pools simultaneously
[[subvault_adapters]]
subvault_address = "0xF00eF6a1fb7CA3Bc620f51f2aBd91549DD486DaA"
additional_adapters = ["aave_v3.aave", "aave_v3.spark"]

# Subvault 2 - Pendle PT token positions with adapter chaining
# Order matters: aave_v3 discovers positions (may include PT/vault tokens)
#                pendle converts any PT tokens to underlying assets
#                erc4626 converts any vault tokens to underlying assets
[[subvault_adapters]]
subvault_address = "0xf37D9264099Fc67448e56e60BC33095F2b2a95d3"
additional_adapters = ["aave_v3.aave", "pendle", "erc4626"]

# Subvault 3 - Uniswap LP positions
# Automatically discovers all NFT positions owned by subvault
[[subvault_adapters]]
subvault_address = "0x9A47b63143FfA375405ddcf0952Fd2C1570915d8"
additional_adapters = ["uniswap_v3", "uniswap_v4"]
